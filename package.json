{
  "name": "@cognoscimus/monorepo",
  "private": true,
  "repository": "cognoscimus/cognoscimus",
  "scripts": {
    "test": "pnpm --filter @cognoscimus/web test",
    "lint": "pnpm --filter @cognoscimus/web lint",
    "dev-web": "pnpm --filter @cognoscimus/web dev-web",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "packageManager": "pnpm@11.1.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@sindresorhus/tsconfig": "^6.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^16.2.7",
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,json}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
