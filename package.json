{
  "name": "@cognoscimus/monorepo",
  "private": true,
  "repository": "cognoscimus/cognoscimus",
  "scripts": {
    "test": "pnpm --filter @cognoscimus/web test",
    "lint": "pnpm --filter @cognoscimus/web lint",
    "dev-web": "pnpm --filter @cognoscimus/web dev-web",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@sindresorhus/tsconfig": "^6.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^16.2.7",
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,json}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
