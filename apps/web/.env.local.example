# Copy to .env.local and fill in. NEXT_PUBLIC_* values are baked in at build time.

# Supabase project (Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server only. Never expose to the browser, never commit.
SUPABASE_ADMIN_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public origin of this app, e.g. http://localhost:3000 in development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Book file storage (S3-compatible, e.g. Hetzner Object Storage). Server only.
S3_ENDPOINT=YOUR_S3_ENDPOINT
S3_REGION=YOUR_S3_REGION
S3_BUCKET_NAME=YOUR_S3_BUCKET
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY

# Per-user storage limit in bytes (default 50 GB).
# NEXT_PUBLIC_STORAGE_FIXED_QUOTA=53687091200
