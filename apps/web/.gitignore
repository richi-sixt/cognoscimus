# dependencies
/node_modules

# testing
/coverage
.test-sandbox-node/
.vitest-attachments/

# next.js
/.next/
/.next-*/
/out/

# production
/build
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# vendor: only what the reader fetches by URL at runtime. Modules the bundler
# imports resolve straight from packages/. Generated by `pnpm setup-vendors`.
/public/vendor

# generated PWA files
/public/sw.js
/public/workbox-*.js
/public/fallback-*.js
/public/swe-worker-*.js

# Word Lens build-input corpora (large, downloaded on demand by
# scripts/build-wordlens-data.mjs); cached locally, not committed.
/data/wordlens/.sources/

# local scratch
.context/
.claude/settings.local.json
