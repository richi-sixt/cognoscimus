{
  "name": "@cognoscimus/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev-web": "dotenv -e .env.web -- next dev",
    "build-web": "dotenv -e .env.web -- next build",
    "start-web": "dotenv -e .env.web -- next start",
    "i18n:extract": "i18next-scanner --config i18next-scanner.config.cjs",
    "lint": "tsc --noEmit && biome lint .",
    "test": "dotenv -e .env -e .env.test.local -- vitest",
    "test:coverage": "dotenv -e .env -e .env.test.local -- vitest run --coverage",
    "test:browser": "dotenv -e .env -e .env.test.local -- vitest run --config vitest.browser.config.mts",
    "test:pr:web:unit": "dotenv -e .env -e .env.test.local -- vitest run --maxWorkers=4",
    "format": "pnpm -w format",
    "format:check": "pnpm -w format:check",
    "prepare-vendor": "mkdirp ./public/vendor/pdfjs",
    "copy-pdfjs-worker": "cpx \"../../packages/foliate-js/node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs\" ./public/vendor/pdfjs",
    "copy-pdfjs-wasm": "cpx \"../../packages/foliate-js/node_modules/pdfjs-dist/wasm/*\" ./public/vendor/pdfjs",
    "copy-pdfjs-fonts": "cpx \"../../packages/foliate-js/node_modules/pdfjs-dist/{cmaps,standard_fonts}/*\" ./public/vendor/pdfjs",
    "copy-flatten-pdfjs-annotation-layer-css": "npx postcss \"../../packages/foliate-js/vendor/pdfjs/annotation_layer_builder.css\" --no-map -u postcss-nested > ./public/vendor/pdfjs/annotation_layer_builder.css",
    "copy-flatten-pdfjs-text-layer-css": "npx postcss \"../../packages/foliate-js/vendor/pdfjs/text_layer_builder.css\" --no-map -u postcss-nested > ./public/vendor/pdfjs/text_layer_builder.css",
    "copy-flatten-pdfjs-css": "pnpm copy-flatten-pdfjs-annotation-layer-css && pnpm copy-flatten-pdfjs-text-layer-css",
    "copy-pdfjs": "pnpm copy-pdfjs-worker && pnpm copy-pdfjs-wasm && pnpm copy-pdfjs-fonts && pnpm copy-flatten-pdfjs-css",
    "setup-pdfjs": "pnpm prepare-vendor && pnpm copy-pdfjs",
    "setup-vendors": "pnpm setup-pdfjs",
    "dictionary:yomitan:convert": "tsx scripts/convert-yomitan-dictionary.ts",
    "check:optional-chaining": "count=$(grep -rno '\\?\\.[a-zA-Z_$]' .next/static/chunks/* out/_next/static/chunks/* | wc -l); if [ \"$count\" -gt 0 ]; then echo '❌ Optional chaining found in output!'; exit 1; else echo '✅ No optional chaining found.'; fi",
    "check:translations": "count=$(grep -rno '__STRING_NOT_TRANSLATED__' public/locales/* | wc -l); if [ \"$count\" -gt 0 ]; then echo '❌ Untranslated strings found!'; exit 1; else echo '✅ All strings translated.'; fi",
    "check:lookbehind-regex": "count=$(grep -rnoE '\\(\\?<[!=]' .next/static/chunks/* out/_next/static/chunks/* | wc -l); if [ \"$count\" -gt 0 ]; then echo '❌ Lookbehind regex found in output!'; exit 1; else echo '✅ No lookbehind regex found.'; fi",
    "check:all": "pnpm check:translations && pnpm check:lookbehind-regex",
    "build-check": "pnpm build-web && pnpm check:all",
    "dev": "dotenv -e .env.web -- next dev",
    "build": "dotenv -e .env.web -- next build",
    "start": "dotenv -e .env.web -- next start",
    "storage:cors": "dotenv -e .env.local -- node scripts/set-bucket-cors.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.81",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emnapi/core": "^1.8.1",
    "@emnapi/runtime": "^1.8.1",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/wasm-runtime": "^1.1.1",
    "@noble/hashes": "^1.8.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@readest/turso-database-common": "0.7.0-pre.3-readest.0",
    "@readest/turso-database-wasm": "0.7.0-pre.3-readest.0",
    "@readest/turso-database-wasm-common": "0.7.0-pre.3-readest.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.76.1",
    "@tybys/wasm-util": "^0.10.1",
    "@zip.js/zip.js": "^2.8.16",
    "ai": "^6.0.299",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "foliate-js": "workspace:*",
    "franc-min": "^6.2.0",
    "fzf": "^0.5.2",
    "highlight.js": "^11.11.1",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "i18next-http-backend": "^4.0.2",
    "iso-639-2": "^3.0.2",
    "iso-639-3": "^3.0.1",
    "jieba-wasm": "^2.4.0",
    "js-md5": "^0.8.3",
    "jwt-decode": "^4.0.0",
    "katex": "^0.18.11",
    "linkedom": "^0.18.14",
    "mammoth": "^1.12.0",
    "marked": "^15.0.12",
    "marked-footnote": "^1.4.0",
    "marked-katex-extension": "^5.1.13",
    "music-metadata": "12.1.0",
    "next": "16.4.2",
    "nunjucks": "^3.2.4",
    "overlayscrollbars": "^2.11.4",
    "overlayscrollbars-react": "^0.5.6",
    "react": "19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "19.2.8",
    "react-i18next": "^15.2.0",
    "react-icons": "^5.4.0",
    "react-responsive": "^10.0.0",
    "react-virtuoso": "^4.17.0",
    "react-window": "^1.8.11",
    "sanitize-html": "^2.18.1",
    "semver": "^7.7.1",
    "styled-jsx": "^5.1.7",
    "tinycolor2": "^1.6.0",
    "uqr": "^0.1.3",
    "uuid": "^14.0.0",
    "virtua": "^0.49.1",
    "ws": "^8.18.3",
    "zod": "^4.0.8",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@tursodatabase/database": "0.6.0-pre.28",
    "@types/cors": "^2.8.17",
    "@types/cssbeautify": "^0.3.5",
    "@types/lunr": "^2.3.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.31",
    "@types/nunjucks": "^3.2.6",
    "@types/react": "^19.0.0",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.0.0",
    "@types/react-window": "^1.8.8",
    "@types/sanitize-html": "^2.16.2",
    "@types/semver": "^7.7.0",
    "@types/tinycolor2": "^1.4.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "caniuse-lite": "^1.0.30001746",
    "cpx2": "^8.0.0",
    "daisyui": "^5.7.22",
    "dotenv-cli": "^7.4.4",
    "fast-check": "^4.8.0",
    "i18next-scanner": "^4.6.0",
    "jsdom": "^28.1.0",
    "mkdirp": "^3.0.1",
    "playwright": "^1.58.2",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "postcss-nested": "^7.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "browserslist": [
    "chrome 92",
    "edge 92",
    "firefox 92",
    "safari 15.2"
  ]
}
